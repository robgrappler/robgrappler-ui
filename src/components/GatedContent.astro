---
export interface Props {
  title?: string;
  subtitle?: string;
  unlocked?: boolean;
}

const {
  title = 'Gated content',
  subtitle = 'Drafted for private review. Tie this block to your auth system once the flow is finalized.',
  unlocked = false
} = Astro.props;
---
<section id="access" class="mx-auto max-w-6xl px-4 pb-24">
  <div class="rounded-2xl border border-white/10 bg-black/20 p-6 backdrop-blur">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-gray-400">Access</p>
        <h2 class="mt-2">{title}</h2>
      </div>
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/40 px-3 py-1 text-xs uppercase tracking-[0.18em] text-gray-300"
      >
        {unlocked ? (
          <span class="text-primary">●</span>
        ) : (
          <svg
            class="h-3 w-3 text-primary"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M7 11V8a5 5 0 0 1 10 0v3"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M5 11h14v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V11z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M12 16v2"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )}
        {unlocked ? 'Unlocked' : 'Locked'}
      </span>
    </div>

    <div class="mt-6 rounded-xl border border-dashed border-white/10 bg-black/15 p-5">
      <p class="text-gray-300">
        {subtitle}
      </p>

      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-lg" href="#">
          Request access
        </a>
        <a
          class="btn btn-lg bg-transparent text-gray-200 border border-white/10 hover:border-primary hover:text-primary"
          href="/design-system"
        >
          View tokens
        </a>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-xs uppercase tracking-[0.22em] text-gray-400">Tokens</p>
          <p class="mt-2 text-sm text-gray-300">Colors, typography, spacing scale.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-xs uppercase tracking-[0.22em] text-gray-400">Components</p>
          <p class="mt-2 text-sm text-gray-300">Header, hero, cards, CTAs.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-xs uppercase tracking-[0.22em] text-gray-400">Workflows</p>
          <p class="mt-2 text-sm text-gray-300">Gated access, sprints, releases.</p>
        </div>
      </div>
    </div>
  </div>
</section>
