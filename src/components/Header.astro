---

import Logo from '../components/Logo.astro';

const navItems = [
  { linkText: 'Design', href: '/' },
  { linkText: 'Edge', href: '/edge' },
  { linkText: 'Blobs', href: '/blobs' },
  { linkText: 'Revalidate', href: '/revalidation' },
  { linkText: 'Images', href: '/image-cdn' },
];
---

<nav class="sticky top-0 z-40 border-b border-white/10 bg-black/30 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="flex items-center gap-3">
      <Logo />
      <span class="sr-only">Robgrappler</span>
    </a>

    {!!navItems?.length && (
      <ul class="hidden flex-1 items-center justify-center gap-2 sm:flex">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded border border-transparent px-3 py-2 text-sm font-semibold uppercase tracking-[0.16em] text-gray-200 transition hover:border-primary hover:text-primary"
            >
              {item.linkText}
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="flex items-center gap-2">
      <a href="#access" class="btn btn-lg sm:min-w-32">
        Unlock
      </a>
    </div>
  </div>
</nav>
