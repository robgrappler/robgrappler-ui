---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import GatedContent from '../components/GatedContent.astro';

const heroCtas = [
  { label: 'Unlock system', href: '#access' },
  { label: 'View tokens', href: '/api/tokens' }
];
---

<Layout title="Robgrappler UI">
  <Hero
    kicker="Design system draft"
    title="Dark-gold supremacy, shipped."
    tagline="A premium Astro/Tailwind system with header, hero, and gated content—ready for Netlify previews."
    ctas={heroCtas}
  />

  <GatedContent />
</Layout>
